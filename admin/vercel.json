{
  "redirects": [
    { "source": "/", "destination": "https://tem-user-page.vercel.app/home", "permanent": false },
    { "source": "/home", "destination": "https://tem-user-page.vercel.app/home", "permanent": false },
    { "source": "/register", "destination": "https://tem-user-page.vercel.app/register", "permanent": false },
    { "source": "/select-store", "destination": "https://tem-user-page.vercel.app/select-store", "permanent": false },
    { "source": "/success", "destination": "https://tem-user-page.vercel.app/success", "permanent": false },
    { "source": "/history", "destination": "https://tem-user-page.vercel.app/history", "permanent": false },
    { "source": "/trace/:code", "destination": "https://tem-user-page.vercel.app/trace/:code", "permanent": false },
    { "source": "/scan/:code", "destination": "https://tem-user-page.vercel.app/scan/:code", "permanent": false },
    { "source": "/qrcode/:code", "destination": "https://tem-user-page.vercel.app/qrcode/:code", "permanent": false },
    { "source": "/temqr/:code", "destination": "https://tem-user-page.vercel.app/temqr/:code", "permanent": false },
    { "source": "/product-info", "destination": "https://tem-user-page.vercel.app/product-info", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tem-admin.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://tem-user-page.vercel.app/images/:path*"
    },
    {
      "source": "/pdf_assets/:path*",
      "destination": "https://tem-user-page.vercel.app/pdf_assets/:path*"
    },
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}

